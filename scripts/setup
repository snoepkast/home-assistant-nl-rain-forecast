#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Install uv if it isn't already on PATH (needed in fresh devcontainers).
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="${HOME}/.local/bin:${PATH}"
fi

uv sync
uv run pre-commit install
